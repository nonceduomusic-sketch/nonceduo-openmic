# NonceDuo Local Server — Configurazione opzionale
# Copia questo file in .env e modifica i valori se necessario.

# ─────────────────────────────────────────────────────────────
# PIN di emergenza (FORMAT/CLIENTI) — usato nella schermata PIN
# dei formati (Open Mic, Dediche, ecc.) quando il server parte
# completamente offline e non ha mai sincronizzato il PIN cloud.
# Lascialo vuoto per DISATTIVARLO (default: disattivato).
# NON dà accesso all'area Staff/Admin.
# ─────────────────────────────────────────────────────────────
# EMERGENCY_PIN=9999

# Durata sessione PIN locale (clienti), in ms — default 24h.
# LOCAL_SESSION_TTL_MS=86400000


# ─────────────────────────────────────────────────────────────
# STAFF — Accesso /admin OFFLINE
# ─────────────────────────────────────────────────────────────
# Quando uno Staff (admin/owner/moderator/operator) effettua
# login a /admin con Internet, le sue credenziali vengono
# memorizzate in forma HASHED (PBKDF2) in data/staff-cache.json
# così può rientrare ANCHE senza Internet con la stessa
# email/password. Nessuna password in chiaro viene salvata.
#
# Durata cache (giorni). Default 30.
# STAFF_CACHE_TTL_DAYS=30
#
# Durata token sessione locale Staff (ms). Default 12h.
# STAFF_LOCAL_TOKEN_TTL_MS=43200000
#
# Segreto HMAC per firmare i token Staff locali.
# Se VUOTO, il server lo genera automaticamente al primo avvio.
# STAFF_LOCAL_TOKEN_SECRET=
#
# Whitelist email autorizzate alla cache (separate da virgola).
# Se vuota, TUTTI gli Staff che fanno login vengono memorizzati.
# Esempio: STAFF_CACHE_ALLOWED_EMAILS=admin@nonceduo.com,iaco@nonceduo.com
# STAFF_CACHE_ALLOWED_EMAILS=

# ─────────────────────────────────────────────────────────────
# STAFF_MASTER_PIN (EMERGENZA — PC nuovo / cache vuota)
# Concede accesso /admin in modalità SOLO LOCALE quando
# la cache Staff è vuota o corrotta. NON sincronizza con
# il cloud finché non rientri da utente reale.
# Lascialo vuoto per DISATTIVARLO (default: disattivato).
# ─────────────────────────────────────────────────────────────
# STAFF_MASTER_PIN=
# STAFF_MASTER_PIN_ROLE=admin
